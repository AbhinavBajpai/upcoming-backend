# TMDB API Read Access Token (Bearer token), not the v3 API key.
# Keep this server-side; never put it in frontend configuration.
TMDB_READ_ACCESS_TOKEN=

# Defaults below are for local development only. Never deploy these credentials.
DATABASE_URL=postgres://upcoming:upcoming_local@localhost:55432/upcoming
PORT=3000
FRONTEND_DIST_DIR=../upcoming-frontend/dist
# Optional Compose host-port override; also update DATABASE_URL if changed.
POSTGRES_PORT=55432

# Browser-facing port for the containerised app (docker compose up).
APP_PORT=3000

# Local account testing (mail is captured in Mailpit, never sent externally).
AUTH_MODE=local
# For npm dev: use 5173. Docker sets the browser origin from APP_PORT.
AUTH_BASE_URL=http://localhost:5173
# Optional locally; required, random and at least 32 characters for public mode.
# AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_PORT=8025
# Public deployment only: AUTH_MODE=public, HTTPS AUTH_BASE_URL and:
# AUTH_EMAIL_FROM=Upcoming <accounts@your-verified-domain>
# RESEND_API_KEY=
# Exact direct proxy socket IPs allowed to supply CF-Connecting-IP (otherwise ignored):
# AUTH_TRUSTED_PROXY_IPS=
