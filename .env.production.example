# Copy to .env.production, chmod 600, and fill privately.
# scripts/production-compose.sh reads this file, never the local .env.
RELEASE_TAG=
# Generate a random hex password so it is also safe inside DATABASE_URL.
POSTGRES_PASSWORD=
AUTH_SECRET=
RESEND_API_KEY=
TMDB_READ_ACCESS_TOKEN=
AUTH_TRUSTED_PROXY_IPS=
# Host-service cloudflared only: inspect Ubuntu ports before choosing.
APP_PORT=3080
# Docker cloudflared only: exact existing bridge network name.
TUNNEL_NETWORK=
