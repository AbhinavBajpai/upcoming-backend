# Hosted authentication settings for upcoming.crashpalace.uk.
# Copy to .env.public and fill in privately; do not replace the local .env.
# This is an auth-settings template, not a complete deployment environment.
# The local compose.yaml overrides AUTH_MODE and does not load these settings.
# See docs/hosted-setup.md; UP-13 supplies the production Compose configuration.
AUTH_MODE=public
AUTH_BASE_URL=https://upcoming.crashpalace.uk
AUTH_EMAIL_FROM="Upcoming <accounts@mail.upcoming.crashpalace.uk>"
# Generate a unique secret (32+ characters) with a password manager.
AUTH_SECRET=
# Resend sending-only key restricted to mail.upcoming.crashpalace.uk.
RESEND_API_KEY=
# Fill only after inspecting the actual direct proxy connection on Ubuntu.
AUTH_TRUSTED_PROXY_IPS=
