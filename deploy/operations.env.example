# Install privately as /etc/upcoming/operations.env; read by systemd, not sourced.
UPCOMING_ENV_FILE=/opt/upcoming/upcoming-backend/.env.production
UPCOMING_INGRESS=host
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/upcoming/restic-password
# Add backend-specific Restic credentials or SSH key configuration as needed.
# Optional Better Stack URLs: fill only in the private server file.
SYNC_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
