[Unit]
Description=Upcoming sync
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=upcoming
WorkingDirectory=/opt/upcoming/upcoming-backend
EnvironmentFile=/etc/upcoming/operations.env
ExecStart=/opt/upcoming/upcoming-backend/scripts/production-compose.sh run --rm --no-deps sync
TimeoutStartSec=2h
UMask=0077
